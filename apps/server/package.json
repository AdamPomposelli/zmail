    "hono": "4.7.11",
    "imapflow": "1.0.188",
    "jsonrepair": "3.12.0",
    "mailparser": "3.7.3",
    "nodemailer": "7.0.3",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/imapflow": "1.0.22",
    "@types/mailparser": "3.4.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "6.4.17",
    "esbuild": "0.25.5",
    "tsx": "4.19.4",
    "typescript": "catalog:",
    "vitest": "3.2.3"
  }

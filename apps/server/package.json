{
  "name": "@zmail/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./trpc": "./src/trpc/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
